# Local development environment variables for the Klarblatt Cloud Agent.
# These target the local PostgreSQL cluster and the local mailpit mail catcher
# started by .cursor/start.sh. No external secrets are required for local dev.

DATABASE_URL=jdbc:postgresql://localhost:5432/kindle_rss
DATABASE_USER=kindle
DATABASE_PASSWORD=kindle

# Public base URL used to build links in account e-mails.
APP_PUBLIC_URL=http://localhost:8080

# Account e-mail is delivered to the local mailpit catcher (SMTP on :1025,
# web UI on http://localhost:8025). No authentication or TLS for local dev.
MAIL_FROM=noreply@klarblatt.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false

# Signs remember-me cookies (local dev value only).
REMEMBER_ME_KEY=klarblatt-local-dev-remember-me-key

# First administrator account for the /admin dashboard.
ADMIN_EMAILS=admin@klarblatt.local
